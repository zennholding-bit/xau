# =====================================================================
# SUPABASE (obligatoriskt)
# Hämtas från: Supabase Dashboard -> Project Settings -> API
# =====================================================================
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role-nyckeln (INTE anon-nyckeln) - används bara av backend-scripten
# som körs i GitHub Actions, aldrig i frontend/browser.
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# MAKRODATA - FRED API (gratis)
# Skaffa nyckel: https://fred.stlouisfed.org/docs/api/api_key.html
# =====================================================================
FRED_API_KEY=

# =====================================================================
# AI-PROVIDER (valfritt i v1 - lämna tomt så körs enbart regelbaserad analys)
# =====================================================================
OPENAI_API_KEY=
AI_PROVIDER=none
# none | openai | ollama

# =====================================================================
# SYSTEMKONFIG
# =====================================================================
STARTING_BALANCE_SEK=100000
MAX_RISK_PER_TRADE_PCT=0.5
BUY_THRESHOLD=0.65
SELL_THRESHOLD=-0.65
